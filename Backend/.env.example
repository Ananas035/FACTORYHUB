# Placeholder-only configuration. Copy this file to .env and fill it locally.
# Do not commit .env or replace these blanks with real credentials in this template.

# Database and API. Set PORT to 5000 for the current local frontend.
MONGODB_URI=
DB_NAME=
PORT=

# Use strong, unique secrets stored privately. Never use this template as a secret.
JWT_SECRET=
OTP_HASH_SECRET=

# Email provider configuration. All values below are deliberately blank.
# Typical pairs: port 587 / secure false, or port 465 / secure true.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional overrides. Blank values use the defaults implemented in the code.
OTP_TTL_MINUTES=
OTP_MAX_ATTEMPTS=
OTP_RESEND_COOLDOWN_SECONDS=
RESET_TOKEN_TTL_MINUTES=
RATE_LIMIT_SIGNUP_MAX=
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_OTP_VERIFY_MAX=
RATE_LIMIT_OTP_RESEND_MAX=
RATE_LIMIT_FORGOT_PASSWORD_MAX=
RATE_LIMIT_RESET_VERIFY_MAX=
RATE_LIMIT_RESET_RESEND_MAX=
RATE_LIMIT_RESET_PASSWORD_MAX=
